# ── Font ─────────────────────────────────────────────────────────────────────
font-family = "JetBrainsMono Nerd Font"
font-codepoint-map = U+1F1E6-U+1F1FF=Apple Color Emoji
font-size = 14

# ── Window ───────────────────────────────────────────────────────────────────
window-padding-x = 8
window-padding-y = 4

# ── Colors ───────────────────────────────────────────────────────────────────
theme = Catppuccin Latte
palette = 15=#4c4f69
palette = 7=#5c5f77
minimum-contrast = 1

# ── macOS ────────────────────────────────────────────────────────────────────
# left Option = Alt (useful in tmux/nvim)
# Right Option still works normally for @, ~, etc. on Spanish keyboard
macos-option-as-alt = left
macos-titlebar-style = hidden
macos-non-native-fullscreen = visible-menu

# ── Cursor ───────────────────────────────────────────────────────────────────
cursor-style = block
cursor-style-blink = false

# ── Quick Terminal ────────────────────────────────────────────────────────────
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0
keybind = global:cmd+opt+space=toggle_quick_terminal

# ── URLs ─────────────────────────────────────────────────────────────────────
link-url = true

# ── Shell integration ─────────────────────────────────────────────────────────
# tmux manages its own titles, disable ghostty's shell integration title
shell-integration-features = no-cursor
