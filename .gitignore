# Whitelist approach — ignore everything, opt in explicitly
*
.*

# Root files
!.gitignore
!CLAUDE.md
!install.sh
!*.rayconfig

# tmux
!tmux/
!tmux/**
tmux/plugins/

# nvim
!nvim/
!nvim/**

# ghostty
!ghostty/
!ghostty/**

# raycast
!raycast/
!raycast/**
raycast/ai/
raycast/extensions/
raycast/.DS_Store
