#!/usr/bin/env python3
import re
import sys

config_path, theme = sys.argv[1], sys.argv[2]

overrides = {
    "Catppuccin Latte": (
        "theme = Catppuccin Latte\n"
        "palette = 15=#4c4f69\n"   # bright white → dark (fixes invisible text)
        "palette = 7=#5c5f77\n"    # white → darker gray
        "minimum-contrast = 4.5"   # auto-darken any remaining light true-color text
    ),
    "Gruvbox Dark": (
        "theme = Gruvbox Dark\n"
        "minimum-contrast = 1"
    ),
}

block = overrides.get(theme, f"theme = {theme}")

with open(config_path) as f:
    content = f.read()

# Replace theme line plus any consecutive palette/minimum-contrast overrides
content = re.sub(
    r"(?m)^theme = [^\n]+(\n(palette|minimum-contrast) = [^\n]+)*",
    block,
    content,
)

with open(config_path, "w") as f:
    f.write(content)
