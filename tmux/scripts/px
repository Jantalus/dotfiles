#!/usr/bin/env bash
# px — tmux session manager
#
# Usage:
#   px             interactive fzf picker (creates or switches)
#   px <path>      create or switch to session for that path
#   px --all       create sessions for all entries (no attach)
#   px --list      list current sessions
#   px --kill      kill a session (fzf picker)

# Scanned: each fury_* subdir becomes a session
SCAN_DIR="$HOME/Desktop/Pricing"

# Direct: each path becomes its own session
DIRECT_DIRS=(
  "$HOME/.config"
  "$HOME/.config/nvim"
  "$HOME/Desktop"
  "$HOME/Desktop/Pricing/Scripts"
  "$HOME/Desktop/Pricing/bigquery"
  "$HOME/Desktop/Pricing/jira"
  "$HOME/Desktop/Facu/tesis"
  "$HOME/Desktop/http"
  "$HOME/Desktop/db"
)

NO_NVIM_DIRS=(
  "$HOME/Desktop"
  "$HOME/Desktop/Pricing/jira"
)

BQ_DIRS=(
  "$HOME/Desktop/Pricing/bigquery"
)

KULALA_DIRS=(
  "$HOME/Desktop/http"
)

DB_DIRS=(
  "$HOME/Desktop/db"
)

selected_ai_cli() {
  local cli
  cli=$(tmux show-option -gv @ai_cli 2>/dev/null)
  case "$cli" in
  codex | claude)
    echo "$cli"
    ;;
  *)
    echo "claude"
    ;;
  esac
}

session_claude_model() {
  case "$1" in
  jira) echo "claude-haiku-4-5-20251001" ;;
  esac
}

session_codex_model() {
  case "$1" in
  jira) echo "codex-mini-latest" ;;
  esac
}

ai_cli_cmd() {
  local session="$1"
  local cli="$2"
  local model
  if [ "$cli" = "claude" ]; then
    model=$(session_claude_model "$session")
    [ -n "$model" ] && echo "ANTHROPIC_MODEL=$model claude" || echo "$cli"
  elif [ "$cli" = "codex" ]; then
    model=$(session_codex_model "$session")
    [ -n "$model" ] && echo "CODEX_MODEL=$model codex" || echo "$cli"
  else
    echo "$cli"
  fi
}

session_name_for() {
  local base
  base=$(basename "$1")
  base="${base#fury_}"
  base="${base#.}"
  echo "$base"
}

create_or_switch() {
  local dir="$1"
  local session
  local ai_cli
  session=$(session_name_for "$dir")
  ai_cli=$(selected_ai_cli)

  if [ ! -d "$dir" ]; then
    echo "Not a directory: $dir" >&2
    return 1
  fi

  if tmux has-session -t "$session" 2>/dev/null; then
    if [ -n "$TMUX" ]; then
      tmux switch-client -t "$session"
    else
      tmux attach-session -t "$session"
    fi
    return
  fi

  local ai_cmd
  ai_cmd=$(ai_cli_cmd "$session" "$ai_cli")

  local no_nvim=false
  for no_nvim_dir in "${NO_NVIM_DIRS[@]}"; do
    [[ "$dir" == "$no_nvim_dir" ]] && no_nvim=true && break
  done

  local is_kulala=false
  for kulala_dir in "${KULALA_DIRS[@]}"; do
    [[ "$dir" == "$kulala_dir" ]] && is_kulala=true && break
  done

  local is_db=false
  for db_dir in "${DB_DIRS[@]}"; do
    [[ "$dir" == "$db_dir" ]] && is_db=true && break
  done

  local is_bq=false
  for bq_dir in "${BQ_DIRS[@]}"; do
    [[ "$dir" == "$bq_dir" ]] && is_bq=true && break
  done

  tmux new-session -d -s "$session" -c "$dir" -n "work"

  if $is_bq; then
    tmux send-keys -t "${session}:work" "NVIM_DB_MODE=bigquery nvim -c 'DBUIToggle'" Enter
    tmux split-window -t "${session}:work" -h -c "$dir"
    tmux send-keys -t "${session}:work" "$ai_cmd" Enter
    tmux resize-pane -t "${session}:work.left" -x "65%"
    tmux select-pane -t "${session}:work.left"
  elif $is_db; then
    tmux send-keys -t "${session}:work" "nvim -c 'DBUIToggle'" Enter
  elif $is_kulala; then
    tmux send-keys -t "${session}:work" "nvim ." Enter
  elif $no_nvim; then
    tmux send-keys -t "${session}:work" "$ai_cmd" Enter
  else
    tmux send-keys -t "${session}:work" "nvim ." Enter
    tmux split-window -t "${session}:work" -h -c "$dir"
    tmux send-keys -t "${session}:work" "$ai_cmd" Enter
    tmux resize-pane -t "${session}:work.left" -x "65%"
    tmux select-pane -t "${session}:work.left"
  fi

  echo "Created session: $session"

  if [ -n "$TMUX" ]; then
    tmux switch-client -t "$session"
  else
    tmux attach-session -t "$session"
  fi
}

all_dirs() {
  for d in "$SCAN_DIR"/fury_*/; do
    [ -d "$d" ] || continue
    [ -f "${d}.git" ] && continue  # skip git worktrees
    printf '%s\n' "${d%/}"
  done
  for d in "${DIRECT_DIRS[@]}"; do
    [ -d "$d" ] && printf '%s\n' "$d"
  done
}

new_session_dirs() {
  local dir
  local session
  while IFS= read -r dir; do
    session=$(session_name_for "$dir")
    tmux has-session -t "$session" 2>/dev/null || printf '%s\n' "$dir"
  done < <(all_dirs)
}

pick_dir() {
  local choice
  choice=$(
    {
      printf '[custom path]\t__custom__\n'
      new_session_dirs | awk -F'/' '{print $NF "\t" $0}'
    } |
      fzf --prompt="repo > " --height=40% --border \
        --delimiter=$'\t' --with-nth=1 |
      cut -f2
  )

  if [ "$choice" = "__custom__" ]; then
    choice=$(fzf --prompt="path > " --border --height=40% \
      --walker=dir,follow --walker-root="$HOME" </dev/tty)
  fi

  echo "$choice"
}

pick_session() {
  tmux list-sessions -F '#{session_name}' 2>/dev/null |
    fzf --prompt="session > " --height=40% --border
}

case "${1:-}" in
--all)
  while IFS= read -r dir; do
    create_or_switch "$dir" &
  done < <(all_dirs)
  wait
  ;;
--list)
  tmux list-sessions 2>/dev/null || echo "No tmux sessions"
  ;;
--kill)
  session=$(pick_session) || exit 0
  tmux kill-session -t "$session" && echo "Killed: $session"
  ;;
"")
  dir=$(pick_dir) || exit 0
  [ -n "$dir" ] && create_or_switch "$dir"
  ;;
*)
  if [ -d "$1" ]; then
    create_or_switch "$1"
  else
    create_or_switch "$SCAN_DIR/$1"
  fi
  ;;
esac
